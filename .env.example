# pagehub-llm-gateway local dev config
# NOTE: ENV=development activates the X-Twin-* header-override path; every deployed
# environment (Modal, docker-compose-for-not-dev) MUST override ENV to production/staging.
ENV=development
SERVICE_NAME=pagehub-llm-gateway
GIT_COMMIT=local-dev

# Auth token the gateway requires for /v1/messages and /v1/models.
# Claude Code sends this as ANTHROPIC_AUTH_TOKEN; the SDK as x-api-key or Bearer.
GATEWAY_AUTH_TOKEN=local-dev-token

# Separate token for the /v1/admin/* endpoints. Intentionally NOT the same as the
# caller token — a leaked caller token must not be enough to read request history.
ADMIN_AUTH_TOKEN=local-dev-admin-token

# xAI Grok backend
XAI_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
# Default model surfaced via /v1/models and used when an inbound request asks for
# a Claude model id. See https://docs.x.ai/docs/models for the current top model.
# Known ids: grok-4, grok-4-latest, grok-4-1-fast-reasoning, grok-3, grok-beta.
GROK_DEFAULT_MODEL=grok-4

# Database — when set, every request is logged to two tables (requests + request_events).
# Leave empty to fall back to an in-memory recorder (no persistence; useful for `make dev`
# without docker-compose). The docker-compose-built service points at the bundled
# postgres container by default; override here if pointing at Supabase.
DATABASE_URL=postgresql://gateway:gateway@postgres:5432/gateway

# Redact text / tool input / tool result content from the request log.
# Default true locally for debugging; production / staging deployments override to false.
LOG_CONTENT=true

# Limits / timeouts
REQUEST_BODY_MAX_BYTES=4194304
PROVIDER_TIMEOUT_SECONDS=600

# Local dev
PORT=4011
LOG_LEVEL=INFO
