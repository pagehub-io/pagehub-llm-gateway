# pagehub-llm-gateway local dev config
# NOTE: ENV=development activates the X-Twin-* header-override path; every deployed
# environment (Modal, docker-compose-for-not-dev) MUST override ENV to production/staging.
ENV=development
SERVICE_NAME=pagehub-llm-gateway
GIT_COMMIT=local-dev

# Auth token the gateway requires on every /v1/messages and /v1/models request.
# Claude Code sends this as ANTHROPIC_AUTH_TOKEN; the SDK sends it as x-api-key or
# Authorization: Bearer. Pick anything for local dev; rotate in deployed envs.
GATEWAY_AUTH_TOKEN=local-dev-token

# xAI Grok backend
XAI_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
# Default model surfaced through /v1/models and used when an inbound request asks for
# a Claude model id (Claude Code passes the SDK alias unchanged). Set to whatever
# xAI's current top model is — see https://docs.x.ai/docs/models. Common ids:
# grok-4, grok-4-latest, grok-4-1-fast-reasoning, grok-3, grok-beta.
GROK_DEFAULT_MODEL=grok-4

# Timeouts / limits
REQUEST_BODY_MAX_BYTES=4194304
PROVIDER_TIMEOUT_SECONDS=600

# Local dev only — set true to log full request/response bodies. NEVER set in deployed envs.
LOG_CONTENT=false

# Local dev
PORT=4011
LOG_LEVEL=INFO
